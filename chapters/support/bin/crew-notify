#!/usr/bin/env bash
# crew-notify — SANDBOX: wake another role's agent session for a message you just sent.
#
# A file message is durable but passive: the target agent will not notice it until its
# session takes a turn. Herdr delivers that turn. This wrapper is the only sanctioned
# way to do it, because it enforces the two rules that matter:
#
#   1. Inspect before you type. A `working` agent is left alone — typing into a busy
#      agent is the failure this whole design exists to prevent. `blocked` is reported,
#      not overridden. `unknown` (the unreliable-detection case) is resolved by reading
#      the terminal, not by guessing.
#   2. Fire once. The claim key is derived from the message id, so the same message can
#      never produce two prompts, no matter how many observers notice it.
#
# Exit codes: 0 delivered · 3 busy, try later · 4 blocked, needs a human ·
#             5 delivery unconfirmed (claim retained, do not retry blindly) ·
#             9 already notified for this key
#
# Usage: crew-notify <role> [--key KEY] [--message-id ID] [--text TEXT]
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
HANDOFF="$BIN_DIR/handoff"
export FACTORY_DIR="${FACTORY_DIR:-$HOME/work/factory}"

ROLE="" KEY="" MSG_ID="" TEXT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --key) KEY="$2"; shift 2 ;;
    --message-id) MSG_ID="$2"; shift 2 ;;
    --text) TEXT="$2"; shift 2 ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    *) [ -z "$ROLE" ] && ROLE="$1" && shift || { printf 'crew-notify: unexpected argument %s\n' "$1" >&2; exit 2; } ;;
  esac
done
[ -n "$ROLE" ] || { printf 'usage: crew-notify <role> [--message-id ID] [--text TEXT]\n' >&2; exit 2; }

case "$ROLE" in coordinator|developer|qa) ;; *) printf 'crew-notify: %s is not a promptable role\n' "$ROLE" >&2; exit 2 ;; esac

# Default: notify about the oldest unread message for that role.
if [ -z "$MSG_ID" ]; then
  MSG_ID="$("$HANDOFF" inbox "$ROLE" --json 2>/dev/null | jq -r '.[0].message_id // empty')"
fi
KEY="${KEY:-notify:${MSG_ID:-manual}:$ROLE}"
KEY="$(printf '%s' "$KEY" | tr -c 'a-zA-Z0-9._:-' '-')"

if ! "$HANDOFF" claim "$KEY" 2>/dev/null; then
  printf 'crew-notify: %s was already notified for %s\n' "$ROLE" "$KEY" >&2
  exit 9
fi
release() {
  rm -f "$FACTORY_DIR/claims/$KEY/claimed_at" 2>/dev/null &&
    rmdir "$FACTORY_DIR/claims/$KEY" 2>/dev/null || true
}

state="$(herdr agent get "$ROLE" 2>/dev/null | jq -r '.result.agent.agent_status // "unknown"')"
case "$state" in
  working)
    printf 'crew-notify: %s is working; not interrupting it. Poll for its report instead.\n' "$ROLE" >&2
    release; exit 3 ;;
  blocked)
    printf 'crew-notify: %s is blocked and needs a human to look at it:\n' "$ROLE" >&2
    herdr agent read "$ROLE" --lines 20 >&2 2>/dev/null || true
    release; exit 4 ;;
  unknown)
    printf 'crew-notify: %s status is unknown; reading its terminal before deciding\n' "$ROLE" >&2
    snapshot="$FACTORY_DIR/evidence/inspect-$ROLE-$(date -u +%Y%m%d%H%M%S).txt"
    mkdir -p "$FACTORY_DIR/evidence"
    herdr agent read "$ROLE" --lines 40 > "$snapshot" 2>/dev/null || true
    # A prompt still waiting for an answer is a block, whatever the reported status says.
    if grep -qiE 'Do you (want|trust)|\[y/N\]|Enter to confirm' "$snapshot" 2>/dev/null; then
      printf 'crew-notify: %s is waiting on a prompt of its own; see %s\n' "$ROLE" "$snapshot" >&2
      release; exit 4
    fi ;;
esac

if [ -z "$TEXT" ]; then
  TEXT="You have a new message in the handoff directory. Run 'handoff read $ROLE' to collect it, then follow your role contract at $FACTORY_DIR/roles/$ROLE.md."
fi

# Transport acknowledgement is separate from task completion, so this submits the
# prompt and does NOT wait for the turn to end.
#
# `--wait` is deliberately avoided: when submission starts from `idle`, Herdr requires
# it to observe `working` within 5s or it returns agent_prompt_stalled — and a harness
# that takes longer than that to change state gets reported as a failure even though
# the prompt was delivered. A caller that treated that as "not delivered" would
# re-prompt an agent that is already working, which is precisely the mistake this
# script exists to prevent. A successful submission IS the transport acknowledgement.
record="$FACTORY_DIR/evidence/prompt-$ROLE-$(date -u +%Y%m%d%H%M%S).json"
mkdir -p "$FACTORY_DIR/evidence"
if herdr agent prompt "$ROLE" "$TEXT" > "$record" 2>&1; then
  if grep -q '"error"' "$record" 2>/dev/null; then
    code="$(jq -r '.error.code // "unknown"' "$record" 2>/dev/null)"
    printf 'crew-notify: %s rejected the submission (%s); see %s\n' "$ROLE" "$code" "$record" >&2
    case "$code" in
      agent_blocked) release; exit 4 ;;
      *) exit 5 ;;
    esac
  fi
  printf 'crew-notify: submitted to %s (transport acknowledged; this says nothing about completion)\n' "$ROLE" >&2
  exit 0
fi

printf 'crew-notify: submission to %s failed. The claim is kept so nothing re-prompts blindly.\n' "$ROLE" >&2
printf 'crew-notify: inspect it with: herdr agent read %s --lines 40\n' "$ROLE" >&2
exit 5
