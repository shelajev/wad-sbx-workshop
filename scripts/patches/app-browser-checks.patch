diff --git a/tests/unit/browser-launch.test.ts b/tests/unit/browser-launch.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/browser-launch.test.ts
@@ -0,0 +1,12 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { chromium } from "playwright";
+import { openBrowser } from "../support/browser.ts";
+
+test("a Chromium launch failure fails browser setup", async (t) => {
+  const launchError = new Error("Chromium could not load libglib-2.0.so.0");
+  t.mock.method(chromium, "launch", async () => {
+    throw launchError;
+  });
+  await assert.rejects(openBrowser(), (error) => error === launchError);
+});
